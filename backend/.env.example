# ==========================================================
# FixIt Backend Environment Variables Template
# ==========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (For CORS authorization on Render)
# In production on Render, set this to your Vercel deployment URL:
# Example: FRONTEND_URL=https://fixit-system.vercel.app
FRONTEND_URL=http://localhost:5173

# Option 1: Full Database Connection String (Recommended for Cloud DBs like TiDB, Aiven, Railway, Render)
# DATABASE_URL=mysql://avnadmin:password@mysql-college-project.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Option 2: Individual Database Parameters (Used for Local Development & Standard MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fixit_db
DB_PORT=3306

# Enable SSL for cloud databases (set to true if using remote cloud MySQL like Aiven/TiDB)
DB_SSL=false

# Authentication Secrets
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h
